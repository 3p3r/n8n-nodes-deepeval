{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@n8n-deepeval/runtime": ["./packages/runtime/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tooling/**/*.ts", "e2e/**/*.ts", "*.ts"],
  "exclude": [
    "node_modules",
    "out",
    "packages/dashboard",
    "packages/*/dist",
    "packages/*/node_modules"
  ]
}
