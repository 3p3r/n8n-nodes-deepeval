{
  "name": "n8n-nodes-deepeval-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "DeepEval benchmarking nodes for n8n",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "vite-node tooling/generate.ts && biome format --write packages/nodes/examples packages/nodes/src/nodes e2e/generated",
    "ensure-llamafile": "vite-node tooling/ensure-llamafile.ts",
    "vendor": "vite-node tooling/vendor.ts",
    "build": "npm run generate && moon run runtime:build nodes:build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run build && vitest run",
    "test:e2e": "vitest run e2e",
    "check": "npm run typecheck && npm run lint && npm test",
    "pack:nodes": "npm pack --workspace n8n-nodes-deepeval"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@moonrepo/cli": "^2.4.2",
    "@types/node": "^26.1.1",
    "flatted": "^3.4.2",
    "n8n": "^2.30.1",
    "n8n-workflow": "^2.30.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@11.13.0"
}
